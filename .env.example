# Office 365 - App Registration (Azure Portal)
O365_CLIENT_ID=your-client-id-here
O365_CLIENT_SECRET=your-client-secret-here
O365_TENANT_ID=your-tenant-id-here

# Office 365 Kalender-Accounts (E-Mail-Adressen)
O365_ACCOUNT_1=user1@domain.com
O365_ACCOUNT_2=user2@domain.com

# iCloud CalDAV
ICLOUD_USERNAME=your-apple-id@icloud.com
ICLOUD_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
